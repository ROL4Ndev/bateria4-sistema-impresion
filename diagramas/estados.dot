digraph G { graph [rankdir=LR,bgcolor="white",pad=.3,nodesep=.4,ranksep=.6];node [shape=box,fontname="Arial",fontsize=18,style="rounded,filled",fillcolor="#EDF4FA",color="#33516E",margin=".2,.2"];edge [fontname="Arial",fontsize=14,color="#33516E"];p[label="Pendiente"];a[label="En impresión"];c[label="Completado",fillcolor="#DDF5EE"];x[label="Cancelado",fillcolor="#FFF1D3"];p->a[label="iniciar"];a->c[label="completar"];p->x[label="cancelar"]; }